{
  "name": "create-photobeaver-plugin",
  "version": "0.1.0",
  "description": "Scaffold a Photo Beaver connector or enricher plugin",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "create-photobeaver-plugin": "bin/create-photobeaver-plugin.js"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.js --log-level=warning",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@photobeaver/shared": "workspace:*",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "vitest": "^5.0.3"
  }
}
