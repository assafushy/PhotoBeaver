{
  "name": "@photobeaver/enricher-geocode",
  "version": "0.1.0",
  "private": true,
  "description": "Offline reverse geocoding of photo locations into place names",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./photobeaver-plugin.json"
  },
  "scripts": {
    "build": "pb-plugin build",
    "pack": "pb-plugin pack",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dataset": "node scripts/build-dataset.ts"
  },
  "dependencies": {
    "@photobeaver/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@photobeaver/plugin-cli": "workspace:*",
    "@photobeaver/shared": "workspace:*",
    "@types/node": "^26.6.4",
    "fflate": "^0.8.3",
    "vitest": "^5.0.3"
  }
}
