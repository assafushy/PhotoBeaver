{
  "id": "com.photobeaver.connector-dropbox",
  "name": "Dropbox",
  "version": "0.1.0",
  "type": "connector",
  "apiVersion": "1",
  "main": "dist/index.js",
  "description": "Index photos and videos from your Dropbox, with incremental sync and Dropbox content hashes for duplicate detection.",
  "author": { "name": "Photo Beaver" },
  "license": "MIT",
  "engines": { "photobeaver": ">=0.1.0" },
  "default": { "enabledOnInstall": true },
  "permissions": {
    "network": ["www.dropbox.com", "api.dropboxapi.com", "content.dropboxapi.com"],
    "filesystem": "none",
    "oauth": true,
    "nativeModules": false,
    "gpu": false
  },
  "connector": {
    "syncModes": ["poll"],
    "defaultIntervalSec": 3600,
    "minIntervalSec": 600,
    "supportsIncremental": true,
    "providesContentHash": true,
    "rateLimit": { "requests": 10, "perSec": 1 },
    "multipleSources": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "folder": {
        "type": "string",
        "title": "Dropbox folder",
        "description": "Leave empty for your whole Dropbox",
        "default": ""
      }
    }
  },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "clientId": {
        "type": "string",
        "title": "App key",
        "description": "The App key of your Dropbox app. The plugin README has a step-by-step guide to create one."
      }
    }
  }
}
