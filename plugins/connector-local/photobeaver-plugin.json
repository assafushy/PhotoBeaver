{
  "id": "com.photobeaver.connector-local",
  "name": "Local folder",
  "version": "0.1.0",
  "type": "connector",
  "apiVersion": "1",
  "main": "dist/index.js",
  "description": "Index photos and videos from folders on this computer, external drives and mounted network shares.",
  "author": { "name": "Photo Beaver" },
  "license": "MIT",
  "engines": { "photobeaver": ">=0.1.0" },
  "default": { "enabledOnInstall": true },
  "permissions": {
    "network": [],
    "filesystem": "user-selected",
    "oauth": false,
    "nativeModules": false,
    "gpu": false
  },
  "connector": {
    "syncModes": ["poll", "manual"],
    "defaultIntervalSec": 3600,
    "minIntervalSec": 60,
    "supportsIncremental": false,
    "providesContentHash": false,
    "multipleSources": true
  },
  "configSchema": {
    "type": "object",
    "required": ["root"],
    "properties": {
      "root": { "type": "string", "format": "directory", "title": "Folder" },
      "includeVideos": { "type": "boolean", "default": true, "title": "Include videos" }
    }
  }
}
